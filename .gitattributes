# Normalise line endings so every platform produces the same diff.
#
# Without this, a Windows checkout rewrites every line of every file the first
# time Git touches it — which turns a three-line change into a whole-file diff
# and makes review impossible.

* text=auto eol=lf

*.ts   text eol=lf
*.tsx  text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.svg  text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.woff binary
*.woff2 binary
*.ico  binary
*.pdf  binary
