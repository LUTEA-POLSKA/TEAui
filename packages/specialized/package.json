{
    "name":  "@tea-ui/specialized",
    "version":  "0.1.0",
    "private":  true,
    "description":  "DECLARED, NOT IMPLEMENTED. Ships no components. Use a dedicated library for these.",
    "license":  "MIT",
    "type":  "module",
    "sideEffects":  false,
    "files":  [
                  "dist",
                  "README.md",
                  "LICENSE"
              ],
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js",
                              "default":  "./dist/index.js"
                          },
                    "./package.json":  "./package.json",
                    "./styles.css":  "./dist/styles.css"
                },
    "types":  "./dist/index.d.ts",
    "module":  "./dist/index.js",
    "publishConfig":  {
                          "access":  "public"
                      },
    "scripts":  {
                    "build":  "tsup \u0026\u0026 node ../../scripts/fix-esm-extensions.mjs specialized \u0026\u0026 node ../../scripts/sync-styles.mjs",
                    "prepublishOnly":  "node ../../scripts/prepublish-guard.mjs"
                },
    "dependencies":  {
