                         "@tea-ui/ux-standards":  "^1.0.0",
                         "@tea-ui/utils":  "^1.0.0",
                         "radix-ui":  "^1.4.3"
                     },
    "peerDependencies":  {
                             "react":  "\u003e=18.2.0 \u003c20.0.0",
                             "react-dom":  "\u003e=18.2.0 \u003c20.0.0"
                         },
