{
  "name": "@tea-ui/ux-standards",
  "version": "1.0.0",
  "description": "The written rules components are held to, as data rather than prose.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
