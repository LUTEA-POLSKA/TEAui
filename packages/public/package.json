{
  "name": "@tea-ui/public",
  "version": "0.1.0",
  "description": "TEA UI — the Public UI layer: marketing sections, website chrome, content blocks, conversion forms and public account screens. A first-class system, not Admin UI in different colours.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/fix-esm-extensions.mjs public && node ../../scripts/sync-styles.mjs"
  },
  "dependencies": {
    "@tea-ui/core": "*",
    "@tea-ui/icons": "*",
    "@tea-ui/ux-standards": "*",
    "@tea-ui/utils": "*",
    "radix-ui": "^1.4.3"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20.0.0",
    "react-dom": ">=18.2.0 <20.0.0"
  }
}
