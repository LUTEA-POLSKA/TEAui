{
  "name": "@tea-ui/templates",
  "version": "0.1.0",
  "description": "Page-level templates assembled from patterns.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/fix-esm-extensions.mjs templates && node ../../scripts/sync-styles.mjs",
    "prepublishOnly": "node ../../scripts/prepublish-guard.mjs"
  },
  "dependencies": {
    "@tea-ui/admin": "^1.0.0",
    "@tea-ui/core": "^1.0.0",
    "@tea-ui/patterns": "^0.1.0",
    "@tea-ui/public": "^1.0.0",
    "@tea-ui/tokens": "^1.0.0",
    "@tea-ui/ux-standards": "^1.0.0",
    "@tea-ui/utils": "^1.0.0"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20.0.0",
    "react-dom": ">=18.2.0 <20.0.0"
  },
  "keywords": [
    "templates",
    "react",
    "pages",
    "design-system",
    "tea-ui"
  ],
  "author": "landnevermore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/landnevermore/TEAui.git",
    "directory": "packages/templates"
  },
  "homepage": "https://landnevermore.github.io/TEAui/docs/",
  "bugs": {
    "url": "https://github.com/landnevermore/TEAui/issues"
  }
}
