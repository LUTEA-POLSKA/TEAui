{
    "name": "@tea-ui/patterns",
    "version": "0.1.1",
        "description": "Composable arrangements that solve recurring interaction problems: FilterBar, ActionBar.",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json",
        "./styles.css": "./dist/styles.css"
    },
    "types": "./dist/index.d.ts",
    "module": "./dist/index.js",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup && node ../../scripts/fix-esm-extensions.mjs patterns && node ../../scripts/sync-styles.mjs",
        "prepublishOnly": "node ../../scripts/prepublish-guard.mjs"
    },
    "dependencies": {
        "@tea-ui/core": "^1.1.0",
        "@tea-ui/ux-standards": "^2.0.0",
        "@tea-ui/utils": "^1.0.0",
        "radix-ui": "^1.4.3"
    },
    "peerDependencies": {
        "react": ">=18.2.0 <20.0.0",
        "react-dom": ">=18.2.0 <20.0.0"
    },
    "keywords": [
        "patterns",
        "react",
        "design-system",
        "composition",
        "tea-ui"
    ],
    "author": "landnevermore",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/landnevermore/TEAui.git",
        "directory": "packages/patterns"
    },
    "homepage": "https://landnevermore.github.io/TEAui/docs/",
    "bugs": {
        "url": "https://github.com/landnevermore/TEAui/issues"
    }
}