{
  "name": "@tea-ui/tokens",
  "version": "0.1.0",
  "description": "TEA UI â€” the design token layer: colour roles, typography, spacing, radii, elevation, motion, density, z-index and the reference themes `tea`, `hsm`, `lutea`.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/index.css",
    "./themes.css": "./src/themes.css",
    "./package.json": "./package.json",
    "./fonts.css": "./dist/fonts.css"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/fix-esm-extensions.mjs tokens && npm run build:css",
    "build:css": "tailwindcss -i ./src/index.css -o ./dist/styles.css --minify && node ../../scripts/build-fonts.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0"
  }
}
