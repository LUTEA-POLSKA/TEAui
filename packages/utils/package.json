{
  "name": "@tea-ui/utils",
  "version": "0.1.0",
  "description": "Shared types, class-name composition and small helpers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/fix-esm-extensions.mjs utils",
    "prepublishOnly": "node ../../scripts/prepublish-guard.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "keywords": [
    "react",
    "typescript",
    "cn",
    "clsx",
    "utility",
    "tea-ui",
    "design-system"
  ],
  "author": "landnevermore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/landnevermore/TEAui.git",
    "directory": "packages/utils"
  },
  "homepage": "https://landnevermore.github.io/TEAui/docs/",
  "bugs": {
    "url": "https://github.com/landnevermore/TEAui/issues"
  }
}
