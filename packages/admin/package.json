{
  "name": "@tea-ui/admin",
  "version": "1.1.0",
  "description": "The admin layer: shell, navigation, data display and product states.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/fix-esm-extensions.mjs admin && node ../../scripts/sync-styles.mjs",
    "prepublishOnly": "node ../../scripts/prepublish-guard.mjs"
  },
  "dependencies": {
    "@tea-ui/core": "^1.1.0",
    "@tea-ui/icons": "^1.1.0",
    "@tea-ui/tokens": "^2.0.0",
    "@tea-ui/ux-standards": "^2.0.0",
    "@tea-ui/utils": "^1.0.0",
    "radix-ui": "^1.4.3"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20.0.0",
    "react-dom": ">=18.2.0 <20.0.0"
  },
  "keywords": [
    "react",
    "admin",
    "dashboard",
    "components",
    "data-display",
    "tea-ui",
    "design-system"
  ],
  "author": "landnevermore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/landnevermore/TEAui.git",
    "directory": "packages/admin"
  },
  "homepage": "https://landnevermore.github.io/TEAui/docs/",
  "bugs": {
    "url": "https://github.com/landnevermore/TEAui/issues"
  }
}
